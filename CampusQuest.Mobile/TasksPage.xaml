<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusQuest.Mobile.TasksPage"
             BackgroundColor="#F9F9F9"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *">
        
        <!-- Top Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,50,20,10">
            <Label Grid.Column="0" Text="🗺️" FontSize="24" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="CampusQuest" FontSize="20" FontAttributes="Bold" TextColor="#1B5E20" VerticalOptions="Center" Margin="8,0,0,0" />
        </Grid>

        <!-- Tabs -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *, *" Padding="20,0" Margin="0,0,0,10">
            <Border x:Name="TabAktif" StrokeShape="RoundRectangle 16" BackgroundColor="#1B5E20" Stroke="Transparent" Padding="0,10" Margin="0,0,4,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabAktifTapped" />
                </Border.GestureRecognizers>
                <Label Text="Aktif" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border x:Name="TabGunluk" Grid.Column="1" StrokeShape="RoundRectangle 16" BackgroundColor="#E8F5E9" Stroke="Transparent" Padding="0,10" Margin="2,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabGunlukTapped" />
                </Border.GestureRecognizers>
                <Label x:Name="TabGunlukLabel" Text="Günlük" FontSize="13" FontAttributes="Bold" TextColor="#1B5E20" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border x:Name="TabTamamlanan" Grid.Column="2" StrokeShape="RoundRectangle 16" BackgroundColor="#E8F5E9" Stroke="Transparent" Padding="0,10" Margin="4,0,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTamamlananTapped" />
                </Border.GestureRecognizers>
                <Label x:Name="TabTamamlananLabel" Text="Tamamlanan" FontSize="13" FontAttributes="Bold" TextColor="#1B5E20" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Content Area -->
        <ScrollView Grid.Row="2">
            <Grid>
                <!-- Aktif Görevler -->
                <VerticalStackLayout x:Name="AktifContent" Padding="20,0,20,20" Spacing="16" IsVisible="True">
                    <VerticalStackLayout x:Name="AktifList" Spacing="16" />
                    
                    <!-- Konum Durumu -->
                    <Border StrokeShape="RoundRectangle 12" BackgroundColor="#E3F2FD" Stroke="Transparent" Padding="16">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="📍" FontSize="16" VerticalOptions="Center" />
                            <Label x:Name="LocationStatusLabel" Text="Konum alınıyor..." FontSize="12" TextColor="#1565C0" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Günlük Görevler -->
                <VerticalStackLayout x:Name="GunlukContent" Padding="20,0,20,20" Spacing="16" IsVisible="False">
                    <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="Transparent" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="📚 Kütüphane Ziyareti" FontSize="16" FontAttributes="Bold" TextColor="#333333" />
                                <Label Grid.Column="1" Text="+50 XP" FontSize="12" FontAttributes="Bold" TextColor="#4CAF50" />
                            </Grid>
                            <Label Text="Bugün kütüphaneyi ziyaret et ve QR'ı tara." FontSize="14" TextColor="#757575" />
                            <ProgressBar Progress="0.0" ProgressColor="#4CAF50" />
                            <Label Text="0/1 Tamamlandı" FontSize="11" TextColor="#9E9E9E" />
                        </VerticalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="Transparent" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="🏃 3 Görev Tamamla" FontSize="16" FontAttributes="Bold" TextColor="#333333" />
                                <Label Grid.Column="1" Text="+100 XP" FontSize="12" FontAttributes="Bold" TextColor="#4CAF50" />
                            </Grid>
                            <Label Text="Bugün 3 farklı görev noktasını ziyaret et." FontSize="14" TextColor="#757575" />
                            <ProgressBar Progress="0.33" ProgressColor="#4CAF50" />
                            <Label Text="1/3 Tamamlandı" FontSize="11" TextColor="#9E9E9E" />
                        </VerticalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="Transparent" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="🤝 Arkadaş Davet Et" FontSize="16" FontAttributes="Bold" TextColor="#333333" />
                                <Label Grid.Column="1" Text="+75 XP" FontSize="12" FontAttributes="Bold" TextColor="#4CAF50" />
                            </Grid>
                            <Label Text="Bir arkadaşını CampusQuest'e davet et." FontSize="14" TextColor="#757575" />
                            <ProgressBar Progress="0.0" ProgressColor="#4CAF50" />
                            <Label Text="0/1 Tamamlandı" FontSize="11" TextColor="#9E9E9E" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Tamamlanan Görevler -->
                <VerticalStackLayout x:Name="TamamlananContent" Padding="20,0,20,20" Spacing="16" IsVisible="False">
                    <VerticalStackLayout x:Name="TamamlananList" Spacing="16" />
                    
                    <Label x:Name="TamamlananEmpty" Text="Henüz tamamlanmış görevin yok. Keşfetmeye başla! 🚀" FontSize="14" TextColor="#9E9E9E" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,40,0,0" IsVisible="True" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
