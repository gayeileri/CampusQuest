<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusQuest.Mobile.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Harita WebView (Tam Ekran) — Senin tüm Leaflet + QR mantığın burada -->
        <WebView x:Name="MapWebView" 
                 HorizontalOptions="Fill" 
                 VerticalOptions="Fill" />

        <!-- Floating UI Overlays -->
        <Grid RowDefinitions="Auto, *, Auto" InputTransparent="True" Padding="16,48,16,16">
            
            <!-- Top Header & Search Bar -->
            <VerticalStackLayout Grid.Row="0" Spacing="16" InputTransparent="False">
                
                <!-- Logo -->
                <Grid ColumnDefinitions="Auto, *">
                    <Label Grid.Column="0" Text="🗺️" FontSize="24" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="CAMPUS QUEST" FontSize="20" FontAttributes="Bold" TextColor="#1B5E20" VerticalOptions="Center" Margin="8,0,0,0" />
                </Grid>



            </VerticalStackLayout>
            
        </Grid>
    </Grid>

</ContentPage>
