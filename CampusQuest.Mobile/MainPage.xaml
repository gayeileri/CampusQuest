<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CampusQuest.Mobile.ViewModels"
             x:Class="CampusQuest.Mobile.MainPage"
             BackgroundColor="#F8FAFC"
             Title="Dashboard">

    <!-- BindingContext moved to code-behind to allow DI (HomeViewModel requires services) -->

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Profil & Karşılama Kartı -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" Margin="0,10,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Hello," FontSize="16" TextColor="#64748B"/>
                    <Label Text="{Binding Username, StringFormat='{0} 👋'}" FontSize="26" FontAttributes="Bold" TextColor="#1E293B"/>
                </VerticalStackLayout>

                <!-- Sağ Üst Yakındaki Görev Rozeti -->
                <Frame Grid.Column="1" BackgroundColor="#E0F2FE" BorderColor="#BAE6FD" CornerRadius="15" Padding="10,5">
                    <Label Text="{Binding NearbyMissionsCount, StringFormat='📍 {0} Near You'}" FontSize="12" FontAttributes="Bold" TextColor="#0369A1"/>
                </Frame>
            </Grid>

            <!-- XP & Level İlerleme Kartı -->
            <Frame BackgroundColor="#6366F1" CornerRadius="15" HasShadow="True" Padding="20" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="{Binding Level, StringFormat='Level {0}'}" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="1" Text="{Binding Xp, StringFormat='{0} XP'}" FontSize="16" FontAttributes="Bold" TextColor="#E0E7FF" VerticalOptions="Center"/>
                    </Grid>
                    <!-- Progress Bar (Seviye İlerleme Çubuğu) -->
                    <ProgressBar Progress="0.4" ProgressColor="#F43F5E" BackgroundColor="#818CF8" HeightRequest="8"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Today's Mission" FontSize="18" FontAttributes="Bold" TextColor="#334155" Margin="0,10,0,0"/>

            <!-- Aktif Görev Kartı -->
            <Frame BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="15" Padding="20" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🔥 CURRENT ACTIVE QUEST" FontSize="11" FontAttributes="Bold" TextColor="#F43F5E" CharacterSpacing="1"/>
                    <Label Text="{Binding CurrentMissionTitle}" FontSize="20" FontAttributes="Bold" TextColor="#1E293B"/>
                    <Label Text="{Binding CurrentMissionDescription}" FontSize="14" TextColor="#475569" LineHeight="1.2"/>

                    <Button Text="Scan QR Code" 
                            BackgroundColor="#6366F1" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            CornerRadius="10" 
                            HeightRequest="48"
                            Margin="0,15,0,0" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>