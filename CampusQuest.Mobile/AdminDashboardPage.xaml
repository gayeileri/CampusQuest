<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusQuest.Mobile.AdminDashboardPage"
             Title="Yönetici Paneli"
             BackgroundColor="#F5F7FA">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Çıkış Yap" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <Label Text="Genel İstatistikler" FontSize="18" FontAttributes="Bold" TextColor="#333333" />
            
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="15">
                <!-- Stat 1 -->
                <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="Transparent" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="👥" FontSize="24" />
                        <Label Text="1,245" FontSize="22" FontAttributes="Bold" TextColor="#1B5E20" />
                        <Label Text="Aktif Öğrenci" FontSize="12" TextColor="#757575" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Stat 2 -->
                <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="Transparent" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="✅" FontSize="24" />
                        <Label Text="8,930" FontSize="22" FontAttributes="Bold" TextColor="#1B5E20" />
                        <Label Text="Tamamlanan Görev" FontSize="12" TextColor="#757575" />
                    </VerticalStackLayout>
                </Border>

                <!-- Stat 3 -->
                <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="Transparent" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📍" FontSize="24" />
                        <Label Text="42" FontSize="22" FontAttributes="Bold" TextColor="#1B5E20" />
                        <Label Text="Aktif Görev Noktası" FontSize="12" TextColor="#757575" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Stat 4 -->
                <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="Transparent" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="⭐" FontSize="24" />
                        <Label Text="45K" FontSize="22" FontAttributes="Bold" TextColor="#1B5E20" />
                        <Label Text="Dağıtılan XP" FontSize="12" TextColor="#757575" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Sistem Etkinliği" FontSize="18" FontAttributes="Bold" TextColor="#333333" Margin="0,10,0,0" />

            <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="Transparent" Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Bu Hafta Görev Tamamlama Oranı" FontSize="14" FontAttributes="Bold" TextColor="#333333" />
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <ProgressBar Progress="0.75" ProgressColor="#4CAF50" VerticalOptions="Center" Margin="0,0,15,0" />
                        <Label Grid.Column="1" Text="%75" FontAttributes="Bold" TextColor="#4CAF50" />
                    </Grid>

                    <Label Text="En Popüler Görev: Merkez Kütüphane" FontSize="12" TextColor="#757575" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Yeni Görev Ekle / Yönet" BackgroundColor="#1B5E20" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="56" Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
