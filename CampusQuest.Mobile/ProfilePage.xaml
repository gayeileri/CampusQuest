<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusQuest.Mobile.ProfilePage"
             BackgroundColor="#F9F9F9"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,20" Spacing="24">
            
            <!-- Top Header -->
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Label Grid.Column="0" Text="🗺️" FontSize="24" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="Kampüs Gezgini" FontSize="20" FontAttributes="Bold" TextColor="#1B5E20" VerticalOptions="Center" Margin="8,0,0,0" />
                <Label Grid.Column="2" Text="👤" FontSize="24" VerticalOptions="Center" />
            </Grid>

            <!-- Profile Info -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                <!-- Avatar -->
                <Grid WidthRequest="100" HeightRequest="100" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 50" Stroke="#E0E0E0" StrokeThickness="2" WidthRequest="100" HeightRequest="100">
                        <Image Source="logo.png" Aspect="AspectFill" BackgroundColor="#E8F5E9" />
                    </Border>
                    <!-- Online Status -->
                    <Border StrokeShape="RoundRectangle 10" Stroke="White" StrokeThickness="3" WidthRequest="20" HeightRequest="20" BackgroundColor="#4CAF50" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,8,8" />
                </Grid>
                
                <!-- Name & Dept -->
                <Label Text="{Binding Username}" FontSize="22" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center" />
                
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#E8F5E9" Stroke="Transparent" HorizontalOptions="Center" Padding="12,4">
                    <Label Text="🎓 Bilgisayar Mühendisliği" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" />
                </Border>
            </VerticalStackLayout>

            <!-- Stats Card -->
            <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E8F5E9" StrokeThickness="2" Padding="20">
                <Grid ColumnDefinitions="*, 1, *, 1, *">
                    <!-- Rank -->
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                        <Label Text="📊" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="{Binding Level}" FontSize="18" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center" />
                        <Label Text="SEVİYE" FontSize="10" FontAttributes="Bold" TextColor="#757575" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    
                    <BoxView Grid.Column="1" WidthRequest="1" BackgroundColor="#EEEEEE" />
                    
                    <!-- XP -->
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                        <Label Text="⭐" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="{Binding TotalXp}" FontSize="18" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center" />
                        <Label Text="TOPLAM XP" FontSize="10" FontAttributes="Bold" TextColor="#757575" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    
                    <BoxView Grid.Column="3" WidthRequest="1" BackgroundColor="#EEEEEE" />
                    
                    <!-- Quests -->
                    <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="4">
                        <Label Text="✅" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="{Binding CompletedMissions.Count}" FontSize="18" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center" />
                        <Label Text="GÖREVLER" FontSize="10" FontAttributes="Bold" TextColor="#757575" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Badges Section -->
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Başarı Rozetleri" FontSize="16" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Tümünü Gör" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTumunuGorTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Badges}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <Border StrokeShape="RoundRectangle 30" Stroke="#E0E0E0" StrokeThickness="1" WidthRequest="60" HeightRequest="60" BackgroundColor="White">
                                        <Label Text="{Binding Icon}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding Name}" FontSize="11" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Settings Section -->
            <VerticalStackLayout Spacing="16">
                <Label Text="Ayarlar" FontSize="16" FontAttributes="Bold" TextColor="#333333" />
                
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="Transparent" Padding="0">
                    <VerticalStackLayout>
                        <!-- Item 1 -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16" HeightRequest="60">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditProfileTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="✏️" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Profili Düzenle" FontSize="14" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center" Margin="12,0,0,0" />
                            <Label Grid.Column="2" Text="➔" FontSize="24" TextColor="#9E9E9E" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#EEEEEE" Margin="16,0" />
                        
                        <!-- Item 2 -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16" HeightRequest="60">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="🔔" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Bildirim Ayarları" FontSize="14" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center" Margin="12,0,0,0" />
                            <Label Grid.Column="2" Text="➔" FontSize="24" TextColor="#9E9E9E" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#EEEEEE" Margin="16,0" />
                        
                        <!-- Item 3 -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16" HeightRequest="60">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSecurityTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="🔒" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Güvenlik" FontSize="14" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center" Margin="12,0,0,0" />
                            <Label Grid.Column="2" Text="➔" FontSize="24" TextColor="#9E9E9E" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#EEEEEE" Margin="16,0" />
                        
                        <!-- Item 4 (Çıkış Yap) -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16" HeightRequest="60">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLogoutTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="🚪" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Çıkış Yap" FontSize="14" FontAttributes="Bold" TextColor="#D32F2F" VerticalOptions="Center" Margin="12,0,0,0" />
                            <Label Grid.Column="2" Text="" FontSize="24" TextColor="#9E9E9E" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
