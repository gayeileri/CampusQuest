<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusQuest.Mobile.SecuritySettingsPage"
             Title="Güvenlik"
             BackgroundColor="#F5F7FA">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <Label Text="Şifre Değiştir" FontSize="18" FontAttributes="Bold" TextColor="#333333" />
            
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Mevcut Şifre" FontSize="14" FontAttributes="Bold" TextColor="#333333" />
                    <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" BackgroundColor="White" Padding="12,0" HeightRequest="50">
                        <Entry Placeholder="Mevcut Şifre" IsPassword="True" FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Yeni Şifre" FontSize="14" FontAttributes="Bold" TextColor="#333333" />
                    <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" BackgroundColor="White" Padding="12,0" HeightRequest="50">
                        <Entry Placeholder="Yeni Şifre" IsPassword="True" FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Yeni Şifre (Tekrar)" FontSize="14" FontAttributes="Bold" TextColor="#333333" />
                    <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" BackgroundColor="White" Padding="12,0" HeightRequest="50">
                        <Entry Placeholder="Yeni Şifre Tekrar" IsPassword="True" FontSize="14" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Button Text="Şifreyi Güncelle" BackgroundColor="#1B5E20" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Margin="0,10,0,0" />

            <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,20" />

            <Label Text="Hesap Yönetimi" FontSize="18" FontAttributes="Bold" TextColor="#D32F2F" />
            
            <Button Text="Hesabımı Sil" BackgroundColor="Transparent" TextColor="#D32F2F" BorderColor="#D32F2F" BorderWidth="2" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" />
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
