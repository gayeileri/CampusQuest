<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusQuest.Mobile.BadgesPage"
             Title="Tüm Rozetler"
             BackgroundColor="#F9F9F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Kazandığın ve Kazanabileceğin Rozetler" FontSize="16" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center" />
            <Label Text="Tüm rozetleri topla, en iyi kaşif sen ol!" FontSize="12" TextColor="#757575" HorizontalOptions="Center" Margin="0,-10,0,10" />

            <!-- Rozetler Listesi -->
            <CollectionView x:Name="BadgesCollection">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="16" HorizontalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="12">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Border StrokeShape="RoundRectangle 40" Stroke="#4CAF50" StrokeThickness="2" WidthRequest="80" HeightRequest="80" BackgroundColor="#E8F5E9" HorizontalOptions="Center">
                                    <Label Text="{Binding Icon}" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Description}" FontSize="11" TextColor="#757575" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
