<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampusQuest.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CampusQuest.Mobile"
    Title="CampusQuest.Mobile">

    <TabBar>
        <Tab Title="Keşfet">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Sıralama">
            <ShellContent ContentTemplate="{DataTemplate local:LeaderboardPage}" Route="LeaderboardPage" />
        </Tab>
        <Tab Title="Görevler">
            <ShellContent ContentTemplate="{DataTemplate local:TasksPage}" Route="TasksPage" />
        </Tab>
        <Tab Title="Profil">
            <ShellContent ContentTemplate="{DataTemplate local:ProfilePage}" Route="ProfilePage" />
        </Tab>
    </TabBar>

</Shell>
