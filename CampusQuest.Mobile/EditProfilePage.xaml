<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusQuest.Mobile.EditProfilePage"
             Title="Profili Düzenle"
             BackgroundColor="#F5F7FA">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Avatar -->
            <Grid WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" Margin="0,20,0,10">
                <Border StrokeShape="RoundRectangle 60" Stroke="#4CAF50" StrokeThickness="2" WidthRequest="120" HeightRequest="120">
                    <Image Source="logo.png" Aspect="AspectFill" BackgroundColor="#E8F5E9" />
                </Border>
                <Border StrokeShape="RoundRectangle 20" BackgroundColor="#1B5E20" Stroke="White" StrokeThickness="2" WidthRequest="40" HeightRequest="40" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,0,0">
                    <Label Text="📷" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Form -->
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Kullanıcı Adı" FontSize="14" FontAttributes="Bold" TextColor="#333333" />
                    <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" BackgroundColor="White" Padding="12,0" HeightRequest="50">
                        <Entry x:Name="UsernameEntry" Placeholder="Kullanıcı Adı" Text="{Binding Username}" FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="E-posta" FontSize="14" FontAttributes="Bold" TextColor="#333333" />
                    <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" BackgroundColor="#F5F5F5" Padding="12,0" HeightRequest="50">
                        <Entry x:Name="EmailEntry" Placeholder="E-posta" Text="{Binding Email}" FontSize="14" IsReadOnly="True" TextColor="#757575" />
                    </Border>
                </VerticalStackLayout>
                
                <VerticalStackLayout Spacing="8">
                    <Label Text="Bölüm" FontSize="14" FontAttributes="Bold" TextColor="#333333" />
                    <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" BackgroundColor="White" Padding="12,0" HeightRequest="50">
                        <Entry x:Name="DepartmentEntry" Placeholder="Örn: Bilgisayar Mühendisliği" Text="Bilgisayar Mühendisliği" FontSize="14" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Button x:Name="SaveButton" Text="Değişiklikleri Kaydet" Clicked="OnSaveClicked" BackgroundColor="#1B5E20" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
